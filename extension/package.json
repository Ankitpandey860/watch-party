    "test": "node --test --test-force-exit test/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.56.1"
  }
}
