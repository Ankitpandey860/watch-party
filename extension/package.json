{
  "name": "watch-party-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch Party companion extension: synchronises the user's OWN Netflix playback with a Watch Party room.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "WP_BUILD_TEST=1 node scripts/build.mjs",
