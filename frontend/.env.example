# Copy to `.env.local` for local development.
# WARNING: every VITE_* value is embedded in the public JavaScript bundle. Public URLs only, no secrets.

# REST base URL.
#  - Local dev: the backend directly (default if unset): http://localhost:4000/api
#  - Production on Vercel: leave UNSET. The app then uses "/api", which frontend/vercel.json
#    rewrites to the Render backend so the session cookie is first-party.
# VITE_API_BASE_URL=http://localhost:4000/api

# Socket.IO server URL. Vercel rewrites cannot carry WebSockets, so in production this MUST point
# straight at the backend (authentication uses a one-time ticket, not cookies).
#   Local dev: derived from VITE_API_BASE_URL (default http://localhost:4000)
#   Production: VITE_SOCKET_URL=https://your-backend.onrender.com
# VITE_SOCKET_URL=http://localhost:4000
