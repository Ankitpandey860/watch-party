# Copy to `.env` for local development. NEVER put real secrets in this file: it is committed.
# On Render, set these in the service's Environment tab instead. See docs/DEPLOYMENT.md.

# ---- Core --------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (used for CORS, OAuth redirects and the OTP e-mail link).
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (used to build the Google callback URL).
BACKEND_URL=http://localhost:4000
# Comma-separated allowed browser origins. Defaults to FRONTEND_URL + localhost dev ports.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (required in production) ----------------------------------------------------
# Production: a Neon/Postgres connection string, e.g.
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require     <- placeholder, use your own
# Local dev without installing Postgres: an embedded database that migrates itself:
#   pglite://memory            (wiped on restart)   or   pglite://./.data/dev   (persists)
DATABASE_URL=pglite://./.data/dev
# Run `npm run migrate` against real databases (or set AUTO_MIGRATE=true).
# AUTO_MIGRATE=false

# ---- Sessions (required in production) ----------------------------------------------------
# Random string, at least 32 characters. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# COOKIE_SECURE=true         # default: true in production, false otherwise
# COOKIE_DOMAIN=             # leave empty (enables the stricter __Host- cookie prefix)
# SESSION_TTL_DAYS=30
# GUEST_SESSION_TTL_HOURS=12
# Number of reverse proxies in front of the app (Render = 1). Wrong values weaken IP rate limits.
TRUST_PROXY_HOPS=1

# ---- Google OAuth (optional: the button is hidden/disabled when unset) ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud Console.
# Default: ${BACKEND_URL}/api/auth/google/callback  (the Vercel-rewrite setup uses
#   https://YOUR-APP.vercel.app/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=

# ---- E-mail OTP over SMTP (optional: without it, e-mail sign-in is unavailable) -------------
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
SMTP_USER=
SMTP_PASS=
# Sender, e.g.  Watch Party <no-reply@example.com>
SMTP_FROM=
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# ---- Rooms / sockets (defaults shown) -------------------------------------------------------
# MAX_ROOMS=200
# MAX_ROOMS_PER_USER=5
# MAX_PARTICIPANTS_PER_ROOM=30
# DISCONNECT_GRACE_SECONDS=60
# HOST_GRACE_SECONDS=20
# EMPTY_ROOM_TTL_SECONDS=30
# ROOM_IDLE_TTL_SECONDS=600
# SOCKET_TICKET_TTL_SECONDS=30

# ---- Rate limits (per window; defaults are generous for real use) ---------------------------
# RL_WINDOW_SECONDS=600
# RL_OTP_REQUEST_PER_IP=10   RL_OTP_REQUEST_PER_EMAIL=3
# RL_OTP_VERIFY_PER_IP=30    RL_OTP_VERIFY_PER_EMAIL=10
# RL_GUEST_PER_IP=30         RL_ROOM_CREATE_PER_USER=10   RL_ROOM_CREATE_PER_IP=20
# RATE_LIMIT_DISABLED=false  # never true in production

# ---- Moderators / browser extension (defaults shown) -----------------------------------------
# Max moderators per room, excluding the host (0-10). The host can lower it per room.
# MAX_MODERATORS_PER_ROOM=3
# Origins allowed to pair the Netflix extension, e.g. chrome-extension://<32-char extension id>
# Empty = any extension origin may pair (a one-time code from a signed-in user is still required).
# Production should pin your published extension's origin.
# EXTENSION_ORIGINS=
# EXTENSION_PAIRING_TTL_SECONDS=120
# EXTENSION_CREDENTIAL_TTL_HOURS=12
